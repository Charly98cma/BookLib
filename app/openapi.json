{
  "openapi": "3.1.0",
  "info": {
    "title": "BookLib",
    "version": "0.1.0"
  },
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "Get a list with all registered users",
        "description": "Returns a list with all registered users on the database, or an empty list\nif there are none.",
        "operationId": "get_all_users_get",
        "responses": {
          "200": {
            "description": "List with all registered users on the database",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/UserDBResponse"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "type": "array",
                  "title": "Response Get All Users Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "users"
        ],
        "summary": "Create a new user",
        "description": "Inserts a new user, and returns the created database entity, if the values\nfollow the next criteria:\n\n* The *username* and *email* are unique (no other user uses them already)\n* The *email* is in email format\n* The *password* length is less than or equals to 72 Bytes.",
        "operationId": "create_user_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User created and returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDBResponse"
                }
              }
            }
          },
          "422": {
            "description": "Username or email not unique, or email in incorrect format",
            "content": {
              "application/json": {
                "example": {
                  "detail": "< reason for failure >"
                }
              }
            }
          }
        }
      }
    },
    "/users/login": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "User login",
        "description": "Login user with username and password.",
        "operationId": "login_users_login_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDBResponse"
                }
              }
            }
          },
          "401": {
            "description": "Wrong credentials",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Wrong Credentials! Username and/or password are incorrect."
                }
              }
            }
          },
          "422": {
            "description": "Invalid format",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Invalid format of username and/or password"
                }
              }
            }
          }
        }
      }
    },
    "/users/{user_id}": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "Update user",
        "description": "Updates the user information if the new values follow the next criteria:\n\n* The new *username* and *email* are unique (no other user uses them already)\n* The new *email* is in email format\n* The new *password* length is less than or equals to 72 Bytes.",
        "operationId": "update_user_users__user_id__put",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User with updated information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDBResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "example": {
                  "detail": "There is no user with that username."
                }
              }
            }
          },
          "422": {
            "description": "New user or email already registered",
            "content": {
              "application/json": {
                "example": {
                  "detail": "Username is already registered."
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "users"
        ],
        "summary": "Delete user",
        "description": "Delete the given user",
        "operationId": "delete_user_users__user_id__delete",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "User Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "example": {
                  "detail": "There is no user with that username."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": [
          "books"
        ],
        "summary": "Get list of books",
        "description": "Yields a list with all the books in the database, or an empty list if there\nare none.",
        "operationId": "read_all_books_books_get",
        "responses": {
          "200": {
            "description": "List with all books on the database",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BookDBResponse"
                  },
                  "type": "array",
                  "title": "Response Read All Books Books Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "books"
        ],
        "summary": "Create a new book",
        "description": "Creates a new book in the database, and returns the newly created entity, if:\n\n* The value of `isbn_10` is not already used by another book\n* The value of `isbn_13` is not already used by another book\n* If present, the value of `hc_book_id` is not already used by another book",
        "operationId": "create_book_books_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Book created and returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDBResponse"
                }
              }
            }
          },
          "422": {
            "description": "ISBN 10 / ISBN 13 / Hardcover ID already being used (must be unique)",
            "content": {
              "application/json": {
                "example": {
                  "detail": "ISBN 10 is already being used!"
                }
              }
            }
          }
        }
      }
    },
    "/books/{book_id}": {
      "put": {
        "tags": [
          "books"
        ],
        "summary": "Update a book",
        "description": "Updates a book of the database, and returns the entity with its updated\nvalues if:\n\n* The value of `isbn_10` is not already used by another book\n* The value of `isbn_13` is not already used by another book\n* If present, the value of `hc_book_id` is not already used by another book",
        "operationId": "update_book_books__book_id__put",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Book Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book with updated values",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookDBResponse"
                }
              }
            }
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No book with given ID"
                }
              }
            }
          },
          "422": {
            "description": "ISBN 10 / ISBN 13 / Hardcover ID already being used (must be unique)",
            "content": {
              "application/json": {
                "example": {
                  "detail": "ISBN 10 is already being used!"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "books"
        ],
        "summary": "Delete book",
        "description": "Deletes the given book",
        "operationId": "delete_book_books__book_id__delete",
        "parameters": [
          {
            "name": "book_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Book Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Book not found",
            "content": {
              "application/json": {
                "example": {
                  "detail": "No book with given ID"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
