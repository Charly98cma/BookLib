  "components": {
    "schemas": {
      "AuthorCreate": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Robert S.A. Corey"
            ]
          },
          "biography": {
            "type": "string",
            "title": "Biography",
            "examples": [
              "So much text, oh my god"
            ]
          },
          "photo_path": {
            "type": "string",
            "title": "Photo Path",
            "examples": [
              "/path/to/photo.png"
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "biography",
          "photo_path"
        ],
        "title": "AuthorCreate",
        "description": "Pydantic model for Author creation"
      },
      "AuthorDBResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id",
            "examples": [
              "52f19e39-20ac-47fd-9df2-53d58c0b3f64"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "Robert S.A. Corey"
            ]
          },
          "biography": {
            "type": "string",
            "title": "Biography",
            "examples": [
              "So much text, oh my god"
            ]
          },
          "photo_path": {
            "type": "string",
            "title": "Photo Path",
            "examples": [
              "/path/to/photo.png"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "biography",
          "photo_path"
        ],
        "title": "AuthorDBResponse",
        "description": "Pydantic model for Author response"
